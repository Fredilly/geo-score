{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geo-score",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/app-router-entry",
  "preview_urls": true,
  "assets": {
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "signal.article6.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
